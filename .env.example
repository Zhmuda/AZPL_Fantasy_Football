# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=azpl_fantasy
POSTGRES_USER=azpl
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-to-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin panel (sqladmin at /admin) — independent from SECRET_KEY on purpose
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# SofaScore
SOFASCORE_TOURNAMENT_ID=709
SOFASCORE_REQUEST_DELAY=2.0
